TELEGRAM_BOT_TOKEN=
ADMIN_USER_ID=
# Comma-separated Telegram user IDs of approved employees. The owner is always allowed.
ALLOWED_USER_IDS=
# Approved group/supergroup IDs. In groups only commands are processed.
ALLOWED_CHAT_IDS=
DATA_DIR=/var/lib/quattro-assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Read-only preview. Password and session never go into Git or reports.
ERP_BASE_URL=https://erp.quattro.space
ERP_LOGIN_NAME=Quattro Assistant
# Set only if the existing ERP login form uses personal usernames.
ERP_USERNAME=
ERP_PASSWORD=
