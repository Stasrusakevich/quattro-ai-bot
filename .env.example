TELEGRAM_BOT_TOKEN=
ADMIN_USER_ID=
# Comma-separated Telegram user IDs of approved employees. The owner is always allowed.
ALLOWED_USER_IDS=
# Approved group/supergroup IDs. In groups only commands are processed.
ALLOWED_CHAT_IDS=
DATA_DIR=/var/lib/quattro-assistant
# AI is opt-in. Keys alone never enable it.
AI_ENABLED=false
# deepseek, openai, anthropic. One provider, no automatic fallback.
AI_PROVIDER=deepseek
# Blank uses the selected provider's default (see docs/AI_CONNECTOR.md).
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Legacy setting: used only for openai when AI_MODEL is blank.
OPENAI_MODEL=gpt-5-mini
